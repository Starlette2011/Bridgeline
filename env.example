# Copy to .env and fill in. Leave the key empty to run in offline demo mode.
ANTHROPIC_API_KEY=
BRIDGELINE_MODEL=claude-sonnet-5-5
PORT=3000
RATE_LIMIT_PER_MIN=30
# Set to 1 when running behind a reverse proxy / PaaS so rate limiting sees real client IPs
TRUST_PROXY=
# Set to 1 to ignore the key and force demo mode
BRIDGELINE_FORCE_DEMO=
